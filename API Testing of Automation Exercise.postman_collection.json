                  "});\r",
                  "\r",
                  "pm.test(\"Response contains products\", () => {\r",
                  "    pm.expect(jsonData).to.have.property(\"products\");\r",
                  "    pm.expect(jsonData.products).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Search returned relevant results\", () => {\r",
                  "    const searchTerm = \"t-shirt\";   // change according to what you searched\r",
                  "    jsonData.products.forEach((product) => {\r",
                  "        const name = product.name.toLowerCase();\r",
                  "        pm.expect(name).to.include(searchTerm.toLowerCase());\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has responseCode 200\", () => {\r",
                  "    pm.expect(jsonData.responseCode).to.eql(200);\r",
                  "});"
