    {
      "name": "Products",
      "item": [
        {
          "name": "get all products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status Code is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response Time is acceptable (< 800ms)\", () => {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(800);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains products array\", () => {\r",
                  "    pm.expect(jsonData).to.have.property(\"products\");\r",
                  "    pm.expect(jsonData.products).to.be.an(\"array\").that.is.not.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Each product has required fields\", () => {\r",
                  "    jsonData.products.forEach((product, index) => {\r",
                  "        pm.expect(product, `Product ${index}`).to.have.all.keys(\"id\", \"name\", \"price\", \"brand\", \"category\");\r",
                  "        pm.expect(product.id).to.be.a(\"number\");\r",
                  "        pm.expect(product.name).to.be.a(\"string\").and.not.empty;\r",
                  "        pm.expect(product.price).to.be.a(\"string\").and.not.empty;\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "// Save first product ID for chaining\r",
                  "if (jsonData.products && jsonData.products.length > 0) {\r",
                  "    pm.environment.set(\"product_id\", jsonData.products[0].id);\r",
                  "}\r",
                  "pm.test(\"Products have valid category structure\", () => {\r",
                  "    jsonData.products.forEach((product, index) => {\r",
                  "        pm.expect(product, `Product ${index}`).to.have.property(\"category\");\r",
                  "        \r",
                  "        const category = product.category;\r",
                  "        pm.expect(category).to.have.property(\"usertype\");\r",
                  "        pm.expect(category).to.have.property(\"category\");\r",
                  "        \r",
                  "        pm.expect(category.usertype).to.have.property(\"usertype\");\r",
                  "        pm.expect(category.category).to.be.a(\"string\").and.not.empty;\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
